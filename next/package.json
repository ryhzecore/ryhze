{
  "name": "ryhze-web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "wrangler dev --local --ip 127.0.0.1 --port 8790 --persist-to ../.wrangler/state",
    "test": "node --test tests/*.test.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "motion": "13.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "prettier": "^3.9.6",
    "typescript": "latest",
    "vite": "8.2.2",
    "wrangler": "4.129.0"
  }
}
