{
    http_port 9080
}

video.ryhze.com:9080 {
    root * C:/Test123

    @health path /health
    handle @health {
        header Access-Control-Allow-Origin "https://ryhzecore.github.io"
        header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
        respond "ok" 200
    }

    @media path /Films/* /Games/*
    handle @media {
        header Access-Control-Allow-Origin "https://ryhzecore.github.io"
        header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
        header Access-Control-Expose-Headers "Accept-Ranges, Content-Length, Content-Range"
        file_server
    }
}